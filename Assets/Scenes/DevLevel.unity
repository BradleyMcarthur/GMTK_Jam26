  m_Script: {fileID: 11500000, guid: 2c053e2f459edcd48979bd8c6210c3fe, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ClockGuyDialogue
  earlyLines:
  - I literally just told you not to do that..
  - Rude. Just rude.
  - Great now ive lost count..
  - Why would you stop me?
  - Thats just the opposite of what i asked
  angryLines:
  - Seriously are you that invested in the numbers going up?
  - At least one of us has a job here.
  - Do you feel big right now?
  - You bring a bad vibe to every room.
  - Surely you have something to get up for?
  - That outfit you wore last week looked terrible btw.
  - You smell like old socks and wasted potential
  interruptionsBeforeAngry: 3
